MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_NAME=todoapp
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=10
ALLOWED_ORIGINS=https://fetodo-six.vercel.app,http://localhost:5000
API_KEY=

# MCP phase 2: local only. Enable with HOST=127.0.0.1 NODE_ENV=development.
MCP_ENABLED=false
# Exact HTTP loopback origins only, e.g. http://localhost:6274 for Inspector.
MCP_ALLOWED_ORIGINS=
