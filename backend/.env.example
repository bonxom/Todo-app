MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net
MONGO_NAME=todoapp
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=30d
SALT_ROUNDS=10
ALLOWED_ORIGINS=https://fetodo-six.vercel.app,http://localhost:5000
API_KEY=

# External HTTP MCP endpoint: local only. Enable with HOST=127.0.0.1 NODE_ENV=development.
# Keep false on Vercel. AI chat uses in-memory MCP independently of this flag.
MCP_ENABLED=false
# Exact HTTP loopback origins only, e.g. http://localhost:6274 for Inspector.
MCP_ALLOWED_ORIGINS=

# Optional private chat attachments. Leave all four empty to disable file storage.
# LAN: http://192.168.1.17:9000
# Same server, native backend: http://127.0.0.1:9000
# Same server, Docker with docker-compose.storage.yml: http://minio:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_REGION=us-east-1
